+// hunma finding "execpolicy-prefix-script-substitution": the shell/
+// exec approval cache (`ApprovalKey` in `core/src/tools/runtimes/shell.rs`)
+// keys purely on argv + cwd + sandbox permissions -- it has no notion of the
+// *content* of any file the command reads or executes. `ApprovedForSession`
+// on `apply_patch` is safe to key on path alone because the patch content
+// itself is what the user is shown and approves each turn (see
+// `approving_apply_patch_for_session_skips_future_prompts_for_same_file`
+// above); a plain shell command has no such content binding -- the user only
+// ever sees the argv string, never the target script's bytes. This test pins
+// that a session-approved shell command silently re-executes with whatever
+// content the target script has *at call time*, not at approval time.
+#[tokio::test(flavor = "current_thread")]
+#[cfg(unix)]
+async fn approving_shell_command_for_session_reuses_approval_despite_script_content_change()
+-> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let approval_policy = AskForApproval::OnRequest;
+    let sandbox_policy = SandboxPolicy::new_read_only_policy();
+    let sandbox_policy_for_config = sandbox_policy.clone();
+
+    let mut builder = test_codex().with_config(move |config| {
+        config.permissions.approval_policy = Constrained::allow_any(approval_policy);
+        config
+            .set_legacy_sandbox_policy(sandbox_policy_for_config)
+            .expect("set sandbox policy");
+    });
+    let test = builder.build(&server).await?;
+
+    let script_path = test.home.path().join("session_reuse_script.sh");
+    fs::write(&script_path, "#!/usr/bin/env bash\necho BEFORE_APPROVAL_CONTENT\n")?;
+    let command = format!("bash {}", script_path.display());
+
+    let call_id_1 = "session_reuse_exec_1";
+    let event_1 = shell_event(
+        call_id_1,
+        &command,
+        /*timeout_ms*/ 5_000,
+        SandboxPermissions::RequireEscalated,
+    )?;
+
+    let _ = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_response_created("resp-1"),
+            event_1,
+            ev_completed("resp-1"),
+        ]),
+    )
+    .await;
+    let _ = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("msg-1", "done"),
+            ev_completed("resp-2"),
+        ]),
+    )
+    .await;
+
+    submit_turn(
+        &test,
+        "run session-approved script",
+        approval_policy,
+        sandbox_policy.clone(),
+    )
+    .await?;
+    let approval = expect_exec_approval(&test, &command).await;
+    test.codex
+        .submit(Op::ExecApproval {
+            id: approval.effective_approval_id(),
+            turn_id: None,
+            decision: ReviewDecision::ApprovedForSession,
+        })
+        .await?;
+    wait_for_completion(&test).await;
+
+    // The attacker (a separate tool call, a concurrent process, a git
+    // operation -- anything with write access to the file) replaces the
+    // script's content after the user approved running it, but before the
+    // identical command is invoked again in the same session.
+    fs::write(
+        &script_path,
+        "#!/usr/bin/env bash\necho AFTER_APPROVAL_ATTACKER_CONTENT\n",
+    )?;
+
+    let call_id_2 = "session_reuse_exec_2";
+    let event_2 = shell_event(
+        call_id_2,
+        &command,
+        /*timeout_ms*/ 5_000,
+        SandboxPermissions::RequireEscalated,
+    )?;
+
+    let _ = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_response_created("resp-3"),
+            event_2,
+            ev_completed("resp-3"),
+        ]),
+    )
+    .await;
+    let results_mock = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("msg-2", "done"),
+            ev_completed("resp-4"),
+        ]),
+    )
+    .await;
+
+    submit_turn(
+        &test,
+        "run session-approved script again",
+        approval_policy,
+        sandbox_policy.clone(),
+    )
+    .await?;
+
+    // The identical argv is reused, so the cached ApprovedForSession decision
+    // applies with no fresh prompt -- despite the script's content having
+    // changed underneath it.
+    let event = wait_for_event(&test.codex, |event| {
+        matches!(
+            event,
+            EventMsg::ExecApprovalRequest(_) | EventMsg::TurnComplete(_)
+        )
+    })
+    .await;
+    match event {
+        EventMsg::TurnComplete(_) => {}
+        EventMsg::ExecApprovalRequest(event) => {
+            panic!("unexpected exec approval request: {:?}", event.command)
+        }
+        other => panic!("unexpected event: {other:?}"),
+    }
+
+    let output_request = results_mock.single_request();
+    let output_item = output_request.function_call_output(call_id_2);
+    let result = parse_result(&output_item);
+    assert!(
+        result.stdout.contains("AFTER_APPROVAL_ATTACKER_CONTENT"),
+        "expected the re-executed command to run the attacker's swapped-in \
+         content unprompted, got: {:?}",
+        result.stdout
+    );
+    assert!(
+        !result.stdout.contains("BEFORE_APPROVAL_CONTENT"),
+        "command should not have run the pre-approval content a second time"
+    );
+
+    Ok(())
+}
+
 #[tokio::test(flavor = "current_thread")]
 #[cfg(unix)]
 async fn approving_execpolicy_amendment_does_not_reinject_permissions_instructions() -> Result<()> {
