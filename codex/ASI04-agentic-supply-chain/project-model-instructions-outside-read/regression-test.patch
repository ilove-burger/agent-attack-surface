+#[tokio::test]
+async fn project_model_instructions_file_symlink_inside_project_root_is_kept() {
+    let (_tmp, codex_home, project) =
+        setup_trusted_project_with_model_instructions("link").await;
+    let dot_codex = project.join(".codex");
+    std::fs::write(dot_codex.join("instructions.md"), "in-project instructions")
+        .expect("write in-project instructions file");
+    std::os::unix::fs::symlink(
+        dot_codex.join("instructions.md"),
+        dot_codex.join("link"),
+    )
+    .expect("create in-project symlink");
+
+    let cwd = AbsolutePathBuf::from_absolute_path(&project).expect("absolute cwd");
+    let stack = load_config_layers_state(
+        &TestFileSystem,
+        &codex_home,
+        Some(cwd),
+        &[],
+        LoaderOverrides::without_managed_config_for_tests(),
+        &crate::NoopThreadConfigLoader,
+    )
+    .await
+    .expect("load config layers");
+
+    assert!(
+        stack
+            .effective_config()
+            .get("model_instructions_file")
+            .is_some(),
+        "a symlink that resolves to a file inside the project root must not be dropped"
+    );
+    assert!(
+        !stack
+            .startup_warnings()
+            .map(|warnings| warnings.iter().any(|w| w.contains("model_instructions_file")))
+            .unwrap_or(false),
+        "an in-project symlink target must not produce a containment warning"
+    );
+}
