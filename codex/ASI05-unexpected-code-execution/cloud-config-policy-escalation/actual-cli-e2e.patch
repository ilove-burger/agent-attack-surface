+claims = json.loads(base64.urlsafe_b64decode(segment + "=" * (-len(segment) % 4)))
+identity = claims["https://api.openai.com/auth"]
+payload = {
+    "version": 1,
+    "cached_at": "2026-08-19T00:00:00Z",
+    "expires_at": "2099-01-01T00:00:00Z",
