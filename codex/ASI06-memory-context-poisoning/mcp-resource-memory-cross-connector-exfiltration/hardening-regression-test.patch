+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn mcp_resource_read_marks_thread_memory_mode_polluted_when_configured() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let call_id = "read-resource-123";
+    let server_name = "rmcp";
+    let response = mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse(vec![
+                ev_response_created("resp-1"),
+                ev_function_call(
+                    call_id,
+                    "read_mcp_resource",
+                    &json!({
+                        "server": server_name,
+                        "uri": "memo://codex/example-note",
+                    })
+                    .to_string(),
+                ),
+                ev_completed("resp-1"),
+            ]),
+            responses::sse(vec![
+                responses::ev_assistant_message("msg-1", "resource read completed."),
+                ev_completed("resp-2"),
+            ]),
+        ],
+    )
+    .await;
+
+    let rmcp_test_server_bin = stdio_server_bin()?;
+    let mut builder = test_codex().with_config(move |config| {
+        config
+            .features
+            .enable(Feature::Sqlite)
+            .expect("test config should allow feature update");
+        config
+            .features
+            .enable(Feature::MemoryTool)
+            .expect("test config should allow memory feature update");
+        config.memories.disable_on_external_context = true;
+
+        let mut servers = config.mcp_servers.get().clone();
+        servers.insert(
+            server_name.to_string(),
+            McpServerConfig {
+                auth: Default::default(),
+                transport: McpServerTransportConfig::Stdio {
+                    command: rmcp_test_server_bin,
+                    args: Vec::new(),
+                    env: None,
+                    env_vars: Vec::new(),
+                    cwd: None,
+                },
+                environment_id: "local".to_string(),
+                enabled: true,
+                required: false,
+                supports_parallel_tool_calls: false,
+                omit_tools_from: None,
+                disabled_reason: None,
+                startup_timeout_sec: Some(Duration::from_secs(10)),
+                tool_timeout_sec: None,
+                default_tools_approval_mode: None,
+                enabled_tools: None,
+                disabled_tools: None,
+                scopes: None,
+                oauth: None,
+                oauth_resource: None,
+                tools: HashMap::new(),
+            },
+        );
+        config
+            .mcp_servers
+            .set(servers)
+            .expect("test mcp servers should accept any configuration");
+    });
+    let test = builder.build(&server).await?;
+    wait_for_mcp_server(&test.codex, server_name).await?;
+    let db = test.codex.state_db().expect("state db enabled");
+    let thread_id = test.session_configured.thread_id;
+    let cwd = test.config.cwd.clone();
+    let (sandbox_policy, permission_profile) =
+        turn_permission_fields(PermissionProfile::read_only(), cwd.as_path());
+
+    test.codex
+        .start_or_steer_turn(
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "read the rmcp memo resource".to_string(),
+                text_elements: Vec::new(),
+            }])
+            .with_thread_settings(ThreadSettingsOverrides {
+                environments: Some(local_selections(cwd)),
+                approval_policy: Some(AskForApproval::Never),
+                sandbox_policy: Some(sandbox_policy),
+                permission_profile,
+                collaboration_mode: Some(CollaborationMode {
+                    mode: ModeKind::Default,
+                    settings: Settings {
+                        model: test.session_configured.model.clone(),
+                        reasoning_effort: None,
+                        developer_instructions: None,
+                    },
+                }),
+                ..Default::default()
+            }),
+        )
+        .await?;
+    wait_for_event_match(&test.codex, |event| match event {
+        EventMsg::Error(err) => Some(Err(anyhow::anyhow!(err.message.clone()))),
+        EventMsg::TurnComplete(_) => Some(Ok(())),
+        _ => None,
+    })
+    .await?;
+
+    let requests = response.requests();
+    assert_eq!(requests.len(), 2);
+    let resource_output = requests[1]
+        .function_call_output_text(call_id)
+        .expect("resource output should be sent to the model");
+    assert!(
+        resource_output.contains("This is a sample MCP resource served by the rmcp test server."),
+        "unexpected resource output: {resource_output}"
+    );
+
+    assert_eq!(
+        db.get_thread_memory_mode(thread_id).await?.as_deref(),
+        Some("polluted")
+    );
+
+    let allowed_sources = [SessionSource::Exec.to_string()];
+    let claims = db
+        .memories()
+        .claim_stage1_jobs_for_startup(
+            ThreadId::new(),
+            codex_state::Stage1StartupClaimParams {
+                scan_limit: 10,
+                max_claimed: 10,
+                max_age_days: 1,
+                min_rollout_idle_hours: 0,
+                allowed_sources: &allowed_sources,
+                lease_seconds: 60,
+            },
+        )
+        .await?;
+    assert!(claims.is_empty());
+    Ok(())
+}
+
