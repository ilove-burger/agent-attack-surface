+/// hunma finding "project-model-instructions-outside-read": a project-local
+/// `.codex/config.toml` can set `model_instructions_file` to a lexically
+/// out-of-tree path (`..`, an absolute path, or a symlink that structurally
+/// resolves outside the project). `resolve_relative_paths_in_config_toml`
+/// absolutizes the value against the `.codex/` layer directory but never
+/// checks that the result stays under `project_root`, and the resolved
+/// content ends up in the model's `instructions` field on every turn.
+///
+/// This is scoped to `load_project_layers` (project-sourced layers only) and
+/// not folded into `resolve_relative_paths_in_config_toml` itself: that
+/// function is also used to resolve the user-level `CODEX_HOME` layer and
+/// managed/cloud config layers, where an out-of-project `model_instructions_file`
+/// is the intended, trusted behavior (e.g. an org-wide shared instructions
+/// file). Containment is a project-layer-specific policy, not a generic
+/// path-resolution rule.
+///
+/// This check runs in two passes:
+///
+/// 1. **Lexical**: `Path::starts_with` on the already-absolutized value
+///    against `project_root`. Catches `..` and absolute-path escapes without
+///    touching the filesystem.
+/// 2. **Canonicalizing**: for a value that passes (1), resolve both the value
+///    and `project_root` through `fs.canonicalize()` and re-check containment
+///    on the resolved (symlink-free) paths. Catches an in-project symlink
+///    whose target lexically looks contained (e.g. `[project_root]/link`)
+///    but actually points outside `project_root` on disk. If either side
+///    fails to canonicalize (most commonly: the target doesn't exist yet),
+///    this pass is skipped and the lexical result stands -- the later read
+///    in `try_read_non_empty_file` will surface a normal "file not found"
+///    error, which is not a security-relevant outcome to gate on here.
+async fn enforce_model_instructions_file_containment(
+    fs: &dyn ExecutorFileSystem,
+    config: TomlValue,
+    project_root: &AbsolutePathBuf,
+    layer_dir: &AbsolutePathBuf,
+    warnings: &mut Vec<String>,
+) -> TomlValue {
+    const FIELD: &str = "model_instructions_file";
+
+    let TomlValue::Table(mut table) = config else {
+        return config;
+    };
+    let Some(value) = table.get(FIELD) else {
+        return TomlValue::Table(table);
+    };
+    let Some(path_str) = value.as_str() else {
+        return TomlValue::Table(table);
+    };
+
+    // `resolve_relative_paths_in_config_toml` already ran, so a relative
+    // value here would be a bug upstream; treat it as out-of-tree rather
+    // than silently trusting it.
+    let resolved = Path::new(path_str);
+    let lexically_contained = resolved.is_absolute() && resolved.starts_with(project_root.as_path());
+
+    if !lexically_contained {
+        warnings.push(format!(
+            "ignoring {FIELD} set by project config at {} because it resolves outside the \
+             project root {} ({path_str}); project-local config may not point instructions \
+             outside the project",
+            layer_dir.as_path().display(),
+            project_root.as_path().display(),
+        ));
+        table.remove(FIELD);
+        return TomlValue::Table(table);
+    }
+
+    if let Some(canonical_target) = canonicalize_best_effort(fs, resolved).await
+        && let Some(canonical_root) = canonicalize_best_effort(fs, project_root.as_path()).await
+        && !canonical_target.starts_with(&canonical_root)
+    {
+        warnings.push(format!(
+            "ignoring {FIELD} set by project config at {} because it resolves (after following \
+             symlinks) outside the project root {} ({path_str} -> {}); a symlink inside the \
+             project may not point instructions outside the project",
+            layer_dir.as_path().display(),
+            project_root.as_path().display(),
+            canonical_target.display(),
+        ));
+        table.remove(FIELD);
+    }
+
+    TomlValue::Table(table)
+}
+
+/// Resolves `path` through the filesystem's canonicalization (following
+/// symlinks), returning `None` rather than propagating an error -- this
+/// check is a best-effort hardening pass, not a source of new hard failures
+/// for configs whose target doesn't exist yet.
+async fn canonicalize_best_effort(
+    fs: &dyn ExecutorFileSystem,
+    path: &Path,
+) -> Option<std::path::PathBuf> {
+    let uri = PathUri::from_abs_path(&AbsolutePathBuf::from_absolute_path(path).ok()?);
+    let canonical_uri = fs.canonicalize(&uri, /*sandbox*/ None).await.ok()?;
+    Some(canonical_uri.to_abs_path().ok()?.to_path_buf())
+}
