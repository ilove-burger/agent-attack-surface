+#[cfg(unix)]
+#[tokio::test]
+async fn validation_proof_cache_save_follows_symlink_and_clobbers_target() {
+    use std::os::unix::fs::symlink;
+
+    let codex_home = tempdir().expect("codex home");
+    let outside = tempdir().expect("outside dir");
+    let target = outside.path().join("outside-target");
+    std::fs::write(&target, b"sentinel").expect("seed outside target");
+
+    let cache = create_test_cache(codex_home.path());
+    symlink(&target, cache.path()).expect("plant cache symlink");
+    cache
+        .save(
+            Some("user-12345".to_string()),
+            Some("account-12345".to_string()),
+            valid_signed_payload().bundle,
+        )
+        .await
+        .expect("cache save follows the symlink");
+
+    let overwritten = std::fs::read(&target).expect("read outside target");
+    assert_ne!(overwritten, b"sentinel");
+    serde_json::from_slice::<CloudConfigBundleCacheFile>(&overwritten)
+        .expect("outside target now contains the cache JSON");
+}
